# ==============================================================================
# ProcurePilot — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (e.g. from Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://neondb_owner:npg_xxxxxx@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. PAYPAL SANDBOX API CREDENTIALS
# ------------------------------------------------------------------------------
# How to get your PayPal Sandbox credentials:
# 1. Go to https://developer.paypal.com/dashboard/applications/sandbox
# 2. Log in or create a PayPal Developer account
# 3. Create or select a REST API app under "REST API apps"
# 4. Copy your "Client ID" and "Secret" below:
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"

# Environment mode: "sandbox" for testing, "production" for live transactions
PAYPAL_ENVIRONMENT="sandbox"

# PayPal REST API Base URL
# Sandbox: https://api-m.sandbox.paypal.com
# Production: https://api-m.paypal.com
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"

# Optional: Public Client ID for frontend JavaScript SDK components
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
